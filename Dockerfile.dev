# ローカル開発専用イメージ（本番デプロイは Wrangler が行う）
FROM node:22-bookworm-slim

RUN corepack enable

WORKDIR /app

# 依存だけ先に入れてレイヤキャッシュを効かせる
# pnpm-workspace.yaml も先に置く（onlyBuiltDependencies / allowBuilds を
# install 時に読ませないと esbuild・workerd のネイティブビルドが弾かれる）
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 5173
CMD ["pnpm", "dev", "--host", "0.0.0.0"]
