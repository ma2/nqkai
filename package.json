{
  "name": "nqkai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cross-env CLOUDFLARE_ENV=dev react-router dev",
    "build": "react-router build",
    "preview": "cross-env CLOUDFLARE_ENV=dev wrangler dev",
    "typegen": "react-router typegen && wrangler types --env dev --path worker-configuration.d.ts",
    "typecheck": "pnpm typegen && tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --env dev --local",
    "seed:local": "tsx scripts/seed.ts --local",
    "admin:grant": "tsx scripts/grant-admin.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "drizzle-orm": "0.45.2",
    "isbot": "5.1.31",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "8.3.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260829.1",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
