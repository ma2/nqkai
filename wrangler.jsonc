{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nqkai",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client"
  },
  "observability": {
    "enabled": true
  },
  // 名前付き env はバインディング（vars / d1 / r2 / kv）を継承しないため、各 env に明示的に再宣言する。
  // WEBAUTHN_* は初回デプロイで判明する *.workers.dev のホスト名（またはカスタムドメイン）に合わせて更新する。
  "env": {
    "dev": {
      "name": "nqkai-dev",
      "vars": {
        "WEBAUTHN_RP_ID": "nqkai-dev.mckoy.workers.dev",
        "WEBAUTHN_RP_NAME": "nQkai（dev）",
        "WEBAUTHN_ORIGIN": "https://nqkai-dev.mckoy.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nqkai-dev",
          "database_id": "2a9d30cb-5ffc-4621-81d7-dbd8f42cdca7",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "nqkai-dev"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "ba845020976d4aefb7bd2ee18ce29b14"
        }
      ]
    },
    "production": {
      "name": "nqkai",
      "vars": {
        "WEBAUTHN_RP_ID": "nqkai.mckoy.workers.dev",
        "WEBAUTHN_RP_NAME": "nQkai",
        "WEBAUTHN_ORIGIN": "https://nqkai.mckoy.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nqkai-prod",
          "database_id": "6084cfde-648d-45d6-be8c-26b83bd4b95c",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "nqkai-prod"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "a9c1955eb227473a8faa0695301d2a0d"
        }
      ]
    }
  }
}
