{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nqkai",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/client"
  },
  "observability": {
    "enabled": true
  },
  // 名前付き env はバインディング（vars / d1 / r2 / kv）を継承しないため、各 env に明示的に再宣言する。
  // アカウントの workers.dev サブドメインは `nqkai`。Worker 名で環境を区別する。
  //   staging → https://staging.nqkai.workers.dev
  //   prod    → https://prod.nqkai.workers.dev
  "env": {
    "staging": {
      "name": "staging",
      "vars": {
        "WEBAUTHN_RP_ID": "staging.nqkai.workers.dev",
        "WEBAUTHN_RP_NAME": "nQkai（staging）",
        "WEBAUTHN_ORIGIN": "https://staging.nqkai.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nqkai-staging",
          "database_id": "1f1d1edc-1e83-40e9-97bb-55bbbbee4be3",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "nqkai-staging"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "3a75afdfe34c43d6a6d27b2dc5ce2c8d"
        }
      ]
    },
    "production": {
      "name": "prod",
      "vars": {
        "WEBAUTHN_RP_ID": "prod.nqkai.workers.dev",
        "WEBAUTHN_RP_NAME": "nQkai",
        "WEBAUTHN_ORIGIN": "https://prod.nqkai.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nqkai-prod",
          "database_id": "6084cfde-648d-45d6-be8c-26b83bd4b95c",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "nqkai-prod"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "a9c1955eb227473a8faa0695301d2a0d"
        }
      ]
    }
  }
}
